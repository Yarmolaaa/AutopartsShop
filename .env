# Base URL for the Axios HTTP client.
# Today every request is intercepted by axios-mock-adapter (see src/api/mock),
# so this value is cosmetic. To go live against a real backend later:
#   1. set this to your server, e.g. http://localhost:4000/api
#   2. stop importing the mock in src/main.tsx
VITE_API_BASE_URL=/api
